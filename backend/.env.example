# HawkHire FastAPI Backend - Environment Example File
# Copy this file to .env.{environment} (e.g., .env.production, .env.staging, etc.)
# and fill in the values for your specific environment

# API Configuration
REMOTE_API_URL=https://api.example.com
LOCAL_API_URL=http://localhost:8080
SEMANTIC_SEARCH_URL=${REMOTE_API_URL}

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-url.com
# Additional CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-url.com

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Storage Configuration
ACCESS_KEY_ID=your_access_key_id
SECRET_ACCESS_KEY=your_secret_access_key

# Database Timeouts
POSTGRES_TIMEOUT=30000
SUPABASE_TIMEOUT=30000

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
ENVIRONMENT=development  # development, staging, production

# Processing Configuration
PDF_CONCURRENCY=10
LLM_CONCURRENCY=5
BATCH_SIZE=10
MAX_RETRIES=3
CACHE_TTL=3600

# Security settings
SECRET_KEY=your_secret_key_here  # Generate a secure random key
JWT_SECRET=your_jwt_secret_here  # Generate a secure random key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Integration settings
OPENAI_API_KEY=your_openai_api_key

# To generate a secure key, you can use:
# python -c "import secrets; print(secrets.token_hex(32))" 