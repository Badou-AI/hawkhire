{
    "settings": {
        "number_of_shards": 1,
        "number_of_replicas": 0,
        "analysis": {
            "analyzer": {
                "resume_analyzer": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "asciifolding",
                        "stop",
                        "snowball"
                    ]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "upload_id": {"type": "keyword"},
            "job_id": {"type": "keyword"},
            "timestamp": {"type": "date"},
            "content": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "text",
                        "analyzer": "resume_analyzer"
                    },
                    "profile": {
                        "type": "object",
                        "properties": {
                            "first_name": {
                                "type": "text",
                                "analyzer": "resume_analyzer"
                            },
                            "last_name": {
                                "type": "text",
                                "analyzer": "resume_analyzer"
                            },
                            "tel_num": {"type": "keyword"},
                            "email": {"type": "keyword"}
                        }
                    },
                    "years_of_experience": {
                        "type": "integer", 
                        "analyzer": "resume_analyzer"
                    },
                    "summary": {
                        "type": "text",
                        "analyzer": "resume_analyzer"
                    },
                    "skills": {
                        "type": "nested",
                        "properties": {
                        "skill": {
                            "type": "text",
                            "fields": {
                            "keyword": {
                                "type": "keyword",
                                "ignore_above": 256
                            }
                            }
                        },
                        "score": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1
                        }
                        }
                    },
                    "topics": {"type": "keyword"}
                }
            },
            "file_info": {
                "type": "object",
                "properties": {
                    "name": {"type": "keyword"},
                    "size": {"type": "long"},
                    "mime_type": {"type": "keyword"},
                    "processed_path": {"type": "keyword"}
                }
            },
            "matching_score": {
                "type": "object",
                "properties": {
                    "justification": {
                        "type": "text",
                        "meta": {
                            "description": "justification of the matching score in the language of the document e.g. 'the candidate is a good match for the job because...' or 'the candidate is not a good match for the job because...' and if the resume is in French, the justification should be in French"
                        }
                    },
                    "score": {
                        "type": "float",
                        "minimum": 0,
                        "maximum": 1,
                        "meta": {
                            "description": "score de matching entre 0 et 1"
                        }
                    }
                }
            },
            "embedding": {
                "type": "dense_vector",
                "dims": 1024,
                "index": true,
                "similarity": "cosine"
            }
        }
    }
} 