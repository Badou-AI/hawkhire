-def mrv_leadterm(e, x):
-    """Returns (c0, e0) for e."""
-    Omega = SubsSet()
-    if not e.has(x):
-        return (e, S.Zero)
-    if Omega == SubsSet():
-        Omega, exps = mrv(e, x)
