-    ret = {}
-    for name in names:
-        mtu = cext_posix.net_if_mtu(name)
-        flags = cext_posix.net_if_flags(name)
-
-        # try to get speed and duplex
-        # TODO: rewrite this in C (entstat forks, so use truss -f to follow.
-        # looks like it is using an undocumented ioctl?)
-        duplex = ""
