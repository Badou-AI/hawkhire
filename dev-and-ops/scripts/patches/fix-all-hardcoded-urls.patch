-            elapsed_time = time.time() - start_time
-
-            if fn in self.skip_return_code_checks:
-                self._check_no_test_errors(elapsed_time)
-            else:
-                self._check_return_codes(elapsed_time)
-        finally:
-            # Close all pipes
-            for pipe in self.pid_to_pipe.values():
-                pipe.close()
