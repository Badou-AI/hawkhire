-def _gzip_file_decompress(source_filename, target_filename):
-    """Decompress a gzip file."""
-    with closing(gzip.GzipFile(source_filename, "rb")) as fo:
-        buf = fo.read()
-
-    with open(target_filename, "wb") as fo:
-        fo.write(buf)
