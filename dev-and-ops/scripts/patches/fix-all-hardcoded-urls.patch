-@lru_cache(_DEFAULT_IDNA_SIZE)
-def _idna_decode(raw: str) -> str:
-    try:
-        return idna.decode(raw.encode("ascii"))
-    except UnicodeError:  # e.g. '::1'
-        return raw.encode("ascii").decode("idna")
