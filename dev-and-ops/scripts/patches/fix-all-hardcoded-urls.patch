-        if self._thread:
-            raise RuntimeError("The timer has already started.")
-
-        self._name = name
-
-    def start(self) -> None:
-        """Start the timer."""
-        if self._thread:
-            raise RuntimeError("The timer has already started.")
-
-        self._thread = Thread(
-            target=self._run,
-            name=self._name or "PeriodicTimer",
-            args=(self._ctx,),
-            daemon=True,
