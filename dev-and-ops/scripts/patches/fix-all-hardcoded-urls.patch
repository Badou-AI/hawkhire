-def munge_exc(e, *, suppress_suffix=True, suppress_prefix=True, file=None, skip=0):
-    if file is None:
-        file = inspect.stack()[1 + skip].filename  # skip one frame
-
-    file = _as_posix_path(file)
-    s = _as_posix_path(str(e))
