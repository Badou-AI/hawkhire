# HawkHire Frontend - Environment Example File
# Copy this file to .env.{environment} (e.g., .env.production, .env.staging, etc.)
# and fill in the values for your specific environment

# API Configuration
# Used for client-side API requests
NEXT_PUBLIC_API_URL=http://localhost:8080  # Local development
# NEXT_PUBLIC_API_URL=https://api.hawkhire.ai  # Production
# NEXT_PUBLIC_API_URL=https://api-staging.hawkhire.ai  # Staging

# Used for server-side API requests (Next.js API routes)
PYTHON_API_URL=http://localhost:8080  # Local development
# PYTHON_API_URL=https://api.hawkhire.ai  # Production
# PYTHON_API_URL=https://api-staging.hawkhire.ai  # Staging

NEXT_PUBLIC_FASTAPI_URL=http://localhost:8080  # Local development
# NEXT_PUBLIC_FASTAPI_URL=https://fastapi.hawkhire.ai  # Production
# NEXT_PUBLIC_FASTAPI_URL=https://fastapi-staging.hawkhire.ai  # Staging

# Server Configuration
PORT=3000  # Default port for Next.js

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Optional: For development only - allows you to bypass email verification
NEXT_PUBLIC_SUPABASE_DISABLE_EMAIL_VERIFICATION=false

# Authentication
NEXTAUTH_URL=http://localhost:3000  # Local development
# NEXTAUTH_URL=https://beta.hawkhire.ai  # Production
# NEXTAUTH_URL=https://staging.hawkhire.ai  # Staging

NEXTAUTH_SECRET=your_nextauth_secret_here  # Generate a secure random key

# Application settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Local development
# NEXT_PUBLIC_SITE_URL=https://beta.hawkhire.ai  # Production

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_PREMIUM_FEATURES=false

# Other settings
# Add any other environment-specific settings here

# To generate a secure key, you can use:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 